# tracer: mmiotrace
#
# Synthetic mmiotrace fixture for exercising parse-mmiotrace.py.
# NOT a real capture -- hand-written to match the kernel's text format so the
# parser can be tested before real hardware is available.
#
# Format, per Documentation/trace/mmiotrace.rst:
#   MAP   timestamp pid phys virt len 0
#   R/W   width timestamp pid phys value pc
#   UNMAP timestamp pid virt 0
#
# BAR0 is modelled at physical 0xF2000000 with the 16 MiB register aperture,
# which is what infer_bar_base() should latch onto.
#
MAP 0.000000 1234 0xf2000000 0xffffc90000000000 0x1000000 0
MAP 0.000001 1234 0xf3000000 0xffffc90001000000 0x10000000 0
R 4 0.000100 1234 0xf2000000 0x17700a1 0
R 4 0.000110 1234 0xf2000000 0x177000a1 0
R 4 0.000120 1234 0xf2000a00 0x177010a1 0
R 4 0.000130 1234 0xf2118234 0x000000ff 0
R 4 0.000140 1234 0xf2118234 0x000000ff 0
R 4 0.000150 1234 0xf21183a4 0x00001000 0
R 4 0.000200 1234 0xf2100000 0x00000001 0
W 4 0.000210 1234 0xf2100200 0x00000001 0
W 4 0.000220 1234 0xf2100204 0x0000dead 0
R 4 0.000300 1234 0xf2110040 0x00000000 0
W 4 0.000310 1234 0xf2110040 0xcafe0000 0
W 4 0.000320 1234 0xf2110044 0x0000beef 0
R 4 0.000330 1234 0xf2110100 0x00000010 0
W 4 0.000340 1234 0xf2110130 0x00000002 0
R 4 0.000350 1234 0xf21100f4 0x00000400 0
R 4 0.000400 1234 0xf2000000 0x177000a1 0
W 4 0.000410 1234 0xf2002254 0x0010000f 0
R 4 0.000420 1234 0xf2002270 0x00000000 0
W 4 0.000500 1234 0xf2400000 0x00000001 0
R 4 0.000510 1234 0xf2400004 0x00000000 0
R 4 0.000600 1234 0xf2009400 0x12345678 0
R 2 0.000700 1234 0xf2088000 0x000010de 0
R 1 0.000710 1234 0xf2088008 0x000000a1 0
UNMAP 0.001000 1234 0xffffc90000000000 0
